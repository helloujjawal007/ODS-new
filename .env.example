# Cloud Consultancy - Automated Lead & Newsletter Dispatcher
# Recipient inboxes (default: sales@cloudconsultancy.in, admin@cloudconsultancy.in, vikash@cloudconsultancy.in):
NOTIFICATION_EMAIL=sales@cloudconsultancy.in

# Gmail / Google Workspace SMTP Settings:
# To deliver directly from your Workspace account:
# 1. Sign in to sales@cloudconsultancy.in
# 2. Go to Google Account -> Security -> 2-Step Verification (turn ON if not already)
# 3. Search for "App Passwords" or visit: https://myaccount.google.com/apppasswords
# 4. Create an App password (name it e.g. "Website Contact Form")
# 5. Paste the 16-character password into SMTP_PASS below (no spaces):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sales@cloudconsultancy.in
SMTP_PASS=
SMTP_FROM="Cloud Consultancy" <sales@cloudconsultancy.in>

# Alternative: If using a custom transactional service like Resend or SendGrid:
# RESEND_API_KEY=
